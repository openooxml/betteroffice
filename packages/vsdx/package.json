{
  "name": "@betteroffice/vsdx",
  "version": "0.0.1",
  "description": "Visio-faithful VSDX editor and viewer core (Rust/Wasm).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "bun run build:wasm && tsup",
    "build:wasm": "bun ../../scripts/build-vsdx-wasm.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": { "@types/bun": "^1.3.14", "@types/node": "^26.0.0", "tsup": "^8.5.1", "typescript": "^6.0.3" },
  "license": "Apache-2.0",
  "homepage": "https://betteroffice.dev/",
  "repository": { "type": "git", "url": "https://github.com/openooxml/betteroffice.git", "directory": "packages/vsdx" },
  "publishConfig": { "access": "public" }
}
