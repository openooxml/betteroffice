{
  "name": "@betteroffice/agents",
  "version": "0.1.0",
  "description": "Search, inspect, propose, preview, and export Office document edits through typed tools and MCP.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "bin": {
    "betteroffice-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@betteroffice/docx": "workspace:^",
    "@betteroffice/xlsx": "workspace:^",
    "@betteroffice/pptx": "workspace:^",
    "@betteroffice/fonts": "workspace:^",
    "@modelcontextprotocol/sdk": "~1.31.0",
    "@napi-rs/canvas": "^0.1.80",
    "image-size": "^2.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "jszip": "3.10.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openooxml/betteroffice.git",
    "directory": "packages/agents"
  },
  "publishConfig": {
    "access": "public"
  }
}
