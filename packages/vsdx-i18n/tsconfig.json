{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020"], "module": "ESNext", "skipLibCheck": true,
    "moduleResolution": "bundler", "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "isolatedModules": true, "noEmit": true, "strict": true, "ignoreDeprecations": "6.0",
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "declaration": true, "types": ["bun"]
  },
  "include": ["src"], "exclude": ["node_modules", "dist"]
}
