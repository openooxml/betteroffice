{
  "name": "@betteroffice/fonts",
  "version": "0.1.0",
  "description": "Bundled open fonts for the BetterOffice engine: metric-compatible Latin faces (Carlito, Caladea, Liberation) plus Noto RTL script-coverage faces, with a lazy same-origin loader. CJK faces ship separately in @betteroffice/fonts-cjk.",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "LICENSES",
    "README.md"
  ],
  "scripts": {
    "prebuild": "bun run --filter '@betteroffice/fonts-cjk' build",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@betteroffice/fonts-cjk": "workspace:^0"
  },
  "peerDependenciesMeta": {
    "@betteroffice/fonts-cjk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@betteroffice/fonts-cjk": "workspace:*",
    "@types/bun": "^1.0.0",
    "@types/node": "^26.0.0",
    "tsup": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "fonts",
    "metric-compatible",
    "carlito",
    "caladea",
    "liberation",
    "noto",
    "rtl"
  ],
  "author": "OpenOOXML",
  "license": "(Apache-2.0 AND OFL-1.1)",
  "homepage": "https://betteroffice.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openooxml/betteroffice.git",
    "directory": "packages/fonts"
  },
  "publishConfig": {
    "access": "public"
  }
}
