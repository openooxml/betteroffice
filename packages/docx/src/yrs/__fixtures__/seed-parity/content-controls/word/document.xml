<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml">
  <w:body>
    <w:sdt>
      <w:sdtPr>
        <w:alias w:val="Block control"/>
        <w:tag w:val="blockTag"/>
        <w:id w:val="101"/>
        <w:lock w:val="sdtLocked"/>
      </w:sdtPr>
      <w:sdtContent>
        <w:p><w:r><w:t>Paragraph inside the block content control.</w:t></w:r></w:p>
        <w:p><w:r><w:rPr><w:i/></w:rPr><w:t>Second paragraph inside the same control.</w:t></w:r></w:p>
      </w:sdtContent>
    </w:sdt>
    <w:p>
      <w:r><w:t xml:space="preserve">Plain text then </w:t></w:r>
      <w:sdt>
        <w:sdtPr>
          <w:alias w:val="Plain text control"/>
          <w:tag w:val="inlineText"/>
          <w:id w:val="102"/>
          <w:text/>
        </w:sdtPr>
        <w:sdtContent>
          <w:r><w:t>inline plain text value</w:t></w:r>
        </w:sdtContent>
      </w:sdt>
      <w:r><w:t xml:space="preserve"> then </w:t></w:r>
      <w:sdt>
        <w:sdtPr>
          <w:alias w:val="Choice control"/>
          <w:tag w:val="choice"/>
          <w:id w:val="103"/>
          <w:dropDownList w:lastValue="Beta">
            <w:listItem w:displayText="Alpha" w:value="alpha"/>
            <w:listItem w:displayText="Beta" w:value="beta"/>
          </w:dropDownList>
        </w:sdtPr>
        <w:sdtContent>
          <w:r><w:t>Beta</w:t></w:r>
        </w:sdtContent>
      </w:sdt>
      <w:r><w:t xml:space="preserve"> then </w:t></w:r>
      <w:sdt>
        <w:sdtPr>
          <w:alias w:val="Date control"/>
          <w:tag w:val="when"/>
          <w:id w:val="104"/>
          <w:date w:fullDate="2026-03-04T00:00:00Z"><w:dateFormat w:val="d MMMM yyyy"/><w:lid w:val="en-US"/></w:date>
        </w:sdtPr>
        <w:sdtContent>
          <w:r><w:t>4 March 2026</w:t></w:r>
        </w:sdtContent>
      </w:sdt>
      <w:r><w:t>.</w:t></w:r>
    </w:p>
    <w:sectPr>
      <w:pgSz w:w="12240" w:h="15840"/>
      <w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/>
    </w:sectPr>
  </w:body>
</w:document>
