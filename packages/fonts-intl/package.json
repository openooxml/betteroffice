{
  "name": "@betteroffice/fonts-intl",
  "version": "1.0.0",
  "description": "Optional international Noto coverage faces for @betteroffice/fonts, compressed as font pack format 1.",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "LICENSES",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "fonts",
    "international",
    "noto",
    "docx",
    "ooxml"
  ],
  "author": "OpenOOXML",
  "license": "(Apache-2.0 AND OFL-1.1)",
  "homepage": "https://betteroffice.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openooxml/betteroffice.git",
    "directory": "packages/fonts-intl"
  },
  "bugs": {
    "url": "https://github.com/openooxml/betteroffice/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
