{
  "name": "@betteroffice/vsdx-react",
  "version": "0.0.2",
  "private": true,
  "description": "React VSDX editor for @betteroffice/vsdx: a tabbed ribbon, a searchable standard-shape gallery, a page tab strip and a zoom status bar over move, Shift-drag to resize, add, delete, set fill or line colour, and save. It has no resize-handle or connector-drag UI.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@betteroffice/vsdx": "workspace:*",
    "@betteroffice/vsdx-i18n": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.3",
    "@testing-library/react": "^16.0.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "homepage": "https://betteroffice.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openooxml/betteroffice.git",
    "directory": "packages/vsdx-react"
  },
  "publishConfig": {
    "access": "public"
  }
}
