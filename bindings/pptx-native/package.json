{
  "name": "@betteroffice/pptx-native",
  "version": "0.5.0",
  "private": true,
  "description": "Native Rust bindings for the BetterOffice PPTX engine in Node.js, Bun and Deno.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "betteroffice-pptx-native",
    "packageName": "@betteroffice/pptx-native",
    "npmClient": "npm",
    "rootPublisher": "npm",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi pre-publish --tag-style npm --no-gh-release",
    "test": "bun test",
    "typecheck": "tsc --noEmit --types node --target es2022 --module nodenext index.d.ts"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "presentation",
    "ooxml",
    "nodejs",
    "node-api",
    "bun",
    "deno",
    "native",
    "rust"
  ],
  "license": "Apache-2.0",
  "homepage": "https://betteroffice.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openooxml/betteroffice.git",
    "directory": "bindings/pptx-native"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
