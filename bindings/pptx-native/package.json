{
  "name": "@betteroffice/pptx-native",
  "version": "0.5.1",
  "private": true,
  "description": "Native Rust bindings for the BetterOffice PPTX engine in Node.js, Bun and Deno.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/worker.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/collaboration.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "betteroffice-pptx-native",
    "packageName": "@betteroffice/pptx-native",
    "npmClient": "npm",
    "rootPublisher": "npm",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release && bun run build:js",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi pre-publish --tag-style npm --no-gh-release",
    "test": "bun test",
    "typecheck": "tsc --noEmit --types node --target es2022 --module nodenext index.d.ts && tsc -p js",
    "build:js": "cd js && tsup"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "presentation",
    "ooxml",
    "nodejs",
    "node-api",
    "bun",
    "deno",
    "native",
    "rust"
  ],
  "license": "Apache-2.0",
  "homepage": "https://betteroffice.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openooxml/betteroffice.git",
    "directory": "bindings/pptx-native"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "commonjs",
  "sideEffects": [
    "**/pptxSessionWorker.*",
    "**/session/worker.*"
  ],
  "dependencies": {
    "@betteroffice/fonts": "workspace:^",
    "@betteroffice/fonts-cjk": "workspace:^",
    "@betteroffice/fonts-intl": "workspace:^",
    "@betteroffice/fonts-latin": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
