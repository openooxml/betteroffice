{
  "name": "@betteroffice/demo",
  "private": true,
  "version": "0.0.17",
  "scripts": {
    "build:deck": "bun ../../scripts/create-demo-deck.ts",
    "build:diagram": "bun ../../scripts/create-demo-diagram.ts",
    "build:workbook": "bun ../../scripts/create-demo-workbook.ts",
    "build:wasm": "bun ../../scripts/build-xlsx-wasm.ts && bun ../../scripts/build-docx-wasm.ts && bun ../../scripts/build-pptx-wasm.ts && bun ../../scripts/build-vsdx-wasm.ts",
    "build:seeds": "bun scripts/build-collaboration-seeds.ts",
    "build:deps": "bun ../../scripts/build-stale-packages.ts",
    "check:seeds": "bun scripts/check-collaboration-seeds.ts",
    "predev": "bun run build:deck && bun run build:diagram && bun run build:workbook && bun run build:wasm && bun run build:deps && bun run build:seeds",
    "dev": "next dev",
    "prebuild": "bun run build:deck && bun run build:diagram && bun run build:workbook && bun run build:wasm && bun run build:deps && bun run build:seeds",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@betteroffice/pptx": "workspace:*",
    "@betteroffice/pptx-react": "workspace:*",
    "@betteroffice/vsdx": "workspace:*",
    "@betteroffice/vsdx-react": "workspace:*",
    "@betteroffice/xlsx": "workspace:*",
    "@betteroffice/xlsx-react": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "@betteroffice/docx": "workspace:*",
    "@betteroffice/docx-react": "workspace:*",
    "@betteroffice/fonts": "workspace:*",
    "@betteroffice/fonts-cjk": "workspace:*",
    "@betteroffice/fonts-intl": "workspace:*",
    "@betteroffice/fonts-latin": "workspace:*"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
