{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "bun"],
    "paths": {
      "@betteroffice/docx-react/peerless-harness": ["../../packages/docx-react/dist/peerless-harness.d.mts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
