{
  "name": "@betteroffice/wopi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "test": "bun test src test web/src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "start": "bun src/server.ts"
  },
  "dependencies": {
    "@betteroffice/docx": "workspace:*",
    "@betteroffice/docx-react": "workspace:*",
    "@betteroffice/fonts": "workspace:*",
    "@betteroffice/fonts-cjk": "workspace:*",
    "@betteroffice/pptx": "workspace:*",
    "@betteroffice/pptx-react": "workspace:*",
    "@betteroffice/xlsx": "workspace:*",
    "@betteroffice/xlsx-react": "workspace:*",
    "jszip": "3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "8.3.6"
  }
}
