{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "betteroffice-evals",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "dist"
  },
  "routes": [
    {
      "pattern": "evals.betteroffice.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
