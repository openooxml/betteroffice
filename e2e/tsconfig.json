{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@betteroffice/docx/worker": [
        "../packages/docx/src/worker.ts"
      ],
      "@betteroffice/pptx": [
        "../packages/pptx/src/index.ts"
      ],
      "@betteroffice/pptx/worker": [
        "../packages/pptx/src/worker.ts"
      ],
      "@betteroffice/pptx/editor": [
        "../packages/pptx/src/editor.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}
