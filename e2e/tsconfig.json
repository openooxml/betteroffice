{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@betteroffice/docx/peerless": [
        "../packages/docx/src/peerless.ts"
      ],
      "@betteroffice/docx-react/peerless-harness": [
        "../packages/docx-react/src/components/DocxEditor/peerless/browserHarness.ts"
      ],
      "@betteroffice/pptx": [
        "../packages/pptx/src/index.ts"
      ],
      "@betteroffice/pptx/peerless": [
        "../packages/pptx/src/peerless.ts"
      ],
      "@betteroffice/pptx/editor": [
        "../packages/pptx/src/editor.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}
